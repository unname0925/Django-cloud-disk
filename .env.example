# 複製成 .env 後修改。docker compose 會自動讀取。

# 你的網域，必須指向這台主機的對外 IP（可用 DuckDNS 等免費動態 DNS）
DOMAIN=mydisk.duckdns.org

# 用 python -c "import secrets; print(secrets.token_urlsafe(50))" 產生
DJANGO_SECRET_KEY=請換成隨機長字串

# 網址前綴，請換成自己的隨機字串
SECRET_URL_PREFIX=請換成隨機字串

ALLOW_REGISTRATION=False
STORAGE_DEFAULT_QUOTA_MB=10240
STORAGE_MAX_UPLOAD_SIZE_MB=4096
STORAGE_TRASH_RETENTION_DAYS=30
STORAGE_MAX_VERSIONS=10

# 每天自動備份到 backups volume，保留最新的幾份
AUTO_BACKUP=True
BACKUP_KEEP=7

# 異地備份（擇一或都設定），保留最新的幾份
# 外接硬碟或 NAS：在 docker-compose.yml 掛載到 /offsite
# BACKUP_COPY_DIR=/offsite
# 雲端空間：先用 rclone config 在 ./rclone/rclone.conf 建立名為 gdrive 的遠端
# BACKUP_RCLONE_REMOTE=gdrive:cloud-disk-backups
BACKUP_OFFSITE_KEEP=14

# Email 通知與忘記密碼（Gmail 請使用「應用程式密碼」）
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=你的帳號@gmail.com
# EMAIL_HOST_PASSWORD=應用程式密碼
# SITE_URL=https://mydisk.duckdns.org
